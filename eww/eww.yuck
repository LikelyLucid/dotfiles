(defpoll spotify_state
  :interval "5s"
  :initial "{\"track\":\"Nothing playing\",\"artist\":\"\",\"album\":\"\",\"status\":\"Paused\",\"icon\":\"󰐊\",\"has_track\":false,\"has_art\":false,\"cover_path\":\"\",\"playlists\":[]}"
  `/home/lucid/.config/eww/scripts/spotify-state.sh`)

(defpoll calendar_state
  :interval "5m"
  :initial "{\"today\":\"\",\"month\":\"\",\"connected\":false,\"status\":\"Google Calendar · not connected\",\"events\":[]}"
  `/home/lucid/.config/eww/scripts/calendar-state.py`)

(defwidget calendar_event [event]
  (box :class "calendar-event" :orientation "h" :spacing 10 :hexpand true
    (label :class "calendar-event-time" :text {event.time} :width 112 :xalign 0.0)
    (box :class "calendar-event-copy" :orientation "v" :space-evenly false :hexpand true
      (label :class "calendar-event-title" :text {event.title} :limit-width 32 :xalign 0.0)
      (label :class "calendar-event-meta" :text {event.meta} :limit-width 32 :xalign 0.0 :visible {event.meta != ""}))))

(defwidget calendar_popup []
  (box :class "popup-surface calendar-popup" :orientation "v" :space-evenly false
    (box :class "calendar-heading" :orientation "h" :space-evenly false :vexpand false
      (box :orientation "v" :space-evenly false :hexpand true
        (label :class "popup-eyebrow" :text "CALENDAR")
        (label :class "calendar-status" :text {calendar_state.status}))
      (box :orientation "v" :space-evenly false :halign "end"
        (label :class "calendar-month" :text {calendar_state.month})
        (label :class "calendar-today" :text {calendar_state.today})))
    (box :class "calendar-card" :orientation "v" :space-evenly false
      (calendar
        :class "eww-calendar"
        :show-details true
        :show-heading true
        :show-day-names true
        :show-week-numbers true))
    (box :class "calendar-events-heading" :orientation "h" :space-evenly false :vexpand false
      (label :class "popup-eyebrow" :text "UPCOMING" :hexpand true)
      (label :class "calendar-events-source" :text {calendar_state.connected ? "SYNCED" : "LOCAL"}))
    (scroll :vscroll true :height 168 :vexpand false :valign "start"
      (box :class "calendar-events" :orientation "v" :space-evenly false :vexpand false
        (for event in {calendar_state.events}
          (calendar_event :event event))
        (label
          :class "calendar-empty"
          :text {calendar_state.connected ? "No upcoming events" : "Connect Google Calendar to show events"}
          :visible {arraylength(calendar_state.events) == 0})))))

(defwidget player_action [label action tooltip]
  (eventbox
    :class "popup-action"
    :vexpand false
    :tooltip tooltip
    :onclick "~/.config/eww/scripts/spotify-action.sh ${action}"
    (box :class "popup-action-content" :halign "center" :valign "center"
      (label :text label))))

(defwidget playlist_row [playlist]
  (eventbox
    :class "popup-row"
    :onclick "~/.config/eww/scripts/spotify-action.sh playlist-name \"${playlist}\""
    (box :class "popup-row-content" :hexpand true
      (label :text playlist))))

(defwidget playlist_picker []
  (eventbox
    :class "popup-picker"
    :vexpand false
    :onclick "~/.config/eww/scripts/spotify-playlists-popup.sh"
    (box :class "popup-picker-content" :orientation "h" :space-evenly false
      (label :text "PLAYLISTS" :hexpand true)
      (label :class "popup-picker-arrow" :text "󰅂"))))

(defwidget track_art []
  (image
    :class "track-art track-cover"
    :path {spotify_state.cover_path}
    :image-width 56
    :image-height 56
    :preserve-aspect-ratio true
    :hexpand false
    :vexpand false
    :halign "start"
    :valign "start"
    :visible {spotify_state.has_art}))

(defwidget track_placeholder []
  (box
    :class "track-art track-placeholder"
    :width 56
    :height 56
    :halign "start"
    :valign "start"
    :visible {!spotify_state.has_art}
    (label :class "track-placeholder-icon" :text "󰎆" :halign "center" :valign "center")))

(defwidget spotify_popup []
  (box :class "popup-surface player-popup" :orientation "v" :space-evenly false
    (box :class "track-header" :orientation "h" :spacing 10 :space-evenly false :vexpand false
      (track_art)
      (track_placeholder)
      (box :class "track-info" :orientation "v" :space-evenly false :hexpand true
        (label :class "track-status" :text {spotify_state.status} :hexpand true :xalign 0.0)
        (label :class "track-title" :text {spotify_state.track} :limit-width 28 :hexpand true :xalign 0.0)
        (label :class "track-artist" :text {spotify_state.artist} :limit-width 30 :hexpand true :xalign 0.0 :visible {spotify_state.has_track})
        (label :class "track-album" :text {spotify_state.album} :limit-width 30 :hexpand true :xalign 0.0 :visible {spotify_state.has_track})))
    (box :class "popup-actions" :halign "center" :spacing 4 :space-evenly false :vexpand false
      (player_action :label "󰒮" :action "previous" :tooltip "Previous track")
      (eventbox
        :class "popup-action"
        :vexpand false
        :tooltip "Play or pause"
        :onclick "~/.config/eww/scripts/spotify-action.sh play-pause"
        (box :class "popup-action-content popup-action-primary" :halign "center" :valign "center"
          (label :text {spotify_state.icon})))
      (player_action :label "󰒭" :action "next" :tooltip "Next track")
      (player_action :label "󰒟" :action "shuffle" :tooltip "Toggle shuffle")
      (player_action :label "󰑖" :action "repeat" :tooltip "Cycle repeat"))
    (playlist_picker)))

(defwidget spotify_playlists_popup []
  (box :class "popup-surface playlists-popup" :orientation "v" :space-evenly false
    (box :class "popup-heading" :orientation "v" :space-evenly false :vexpand false
      (label :class "popup-eyebrow" :text "PLAYLISTS")
      (label :class "popup-muted" :text "Select a playlist"))
    (scroll :vscroll true :height 220 :vexpand false :valign "start"
      (box :class "playlist-list" :orientation "v" :space-evenly false :vexpand false
        (for playlist in {spotify_state.playlists}
          (playlist_row :playlist playlist))))))

(defwindow spotify_player
  :monitor 0
  :geometry (geometry :anchor "top center" :y "40px")
  :stacking "fg"
  :focusable "ondemand"
  :unfocus-close true
  :namespace "eww-spotify"
  :windowtype "normal"
  (spotify_popup))

(defwindow spotify_playlists
  :monitor 0
  :geometry (geometry :width "320px" :height "320px" :anchor "top center" :y "40px")
  :stacking "fg"
  :focusable "ondemand"
  :unfocus-close true
  :namespace "eww-spotify-playlists"
  :windowtype "normal"
  (spotify_playlists_popup))

(defwindow calendar_popup
  :monitor 0
  :geometry (geometry :width "390px" :height "500px" :anchor "top left" :y "0px")
  :stacking "fg"
  :focusable "ondemand"
  :unfocus-close true
  :namespace "eww-calendar"
  :windowtype "normal"
  (calendar_popup))
