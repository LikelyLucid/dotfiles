(defpoll spotify_state
  :interval "1s"
  :initial "{\"track\":\"Nothing playing\",\"artist\":\"\",\"album\":\"\",\"status\":\"Paused\",\"icon\":\"󰐊\",\"has_track\":false,\"has_art\":false,\"cover_path\":\"/home/lucid/.config/eww/assets/transparent.svg\",\"shuffle\":false,\"repeat_mode\":\"off\",\"repeat_active\":false,\"repeat_icon\":\"󰑗\"}"
  `/home/lucid/.config/eww/scripts/spotify-state.sh`)

(defpoll spotify_playlists_state
  :interval "10m"
  :initial "[]"
  `/home/lucid/.config/eww/scripts/spotify-playlists-state.sh`)

(defwidget playlist_row [playlist]
  (ui_link_row
    :label playlist
    :icon "󰐕"
    :command "~/.config/eww/scripts/spotify-action.sh playlist-name \"${playlist}\""))

(defwidget track_art []
  (box :class "ui-media"
    (image
      :class "track-cover"
      :path {spotify_state.cover_path}
      :image-width 60
      :image-height 60
      :preserve-aspect-ratio true
      :visible {spotify_state.has_art})
    (label
      :class "ui-media-placeholder"
      :text "󰎆"
      :halign "center"
      :valign "center"
      :visible {!spotify_state.has_art})))

(defwidget spotify_popup_content []
  (box :class "ui-surface ui-popup player-popup" :orientation "v" :space-evenly false
    (ui_header :eyebrow "NOW PLAYING" :title "" :subtitle "" :meta {spotify_state.status})
    (box :class "player-summary" :orientation "h" :spacing 12 :space-evenly false :vexpand false
      (track_art)
      (box :class "player-copy" :orientation "v" :space-evenly false :hexpand true :valign "center"
        (label :class "ui-title player-title" :text {spotify_state.track} :limit-width 28 :xalign 0.0 :hexpand true)
        (label :class "player-artist" :text {spotify_state.artist} :limit-width 30 :xalign 0.0 :visible {spotify_state.has_track})
        (label :class "ui-muted player-album" :text {spotify_state.album} :limit-width 30 :xalign 0.0 :visible {spotify_state.has_track})))
    (box :class "ui-action-bar" :halign "center" :spacing 4 :space-evenly false :vexpand false
      (ui_icon_action :icon "󰒮" :command "~/.config/eww/scripts/spotify-action.sh previous" :tooltip "Previous track" :class "")
      (ui_icon_action :icon {spotify_state.icon} :command "~/.config/eww/scripts/spotify-action.sh play-pause" :tooltip "Play or pause" :class "is-primary")
      (ui_icon_action :icon "󰒭" :command "~/.config/eww/scripts/spotify-action.sh next" :tooltip "Next track" :class "")
      (ui_icon_action :icon {spotify_state.shuffle ? "󰒟" : "󰒞"} :command "~/.config/eww/scripts/spotify-action.sh shuffle" :tooltip {spotify_state.shuffle ? "Shuffle on" : "Shuffle off"} :class {spotify_state.shuffle ? "is-active" : ""})
      (ui_icon_action :icon {spotify_state.repeat_icon} :command "~/.config/eww/scripts/spotify-action.sh repeat" :tooltip {spotify_state.repeat_mode == "track" ? "Repeat track" : spotify_state.repeat_mode == "context" ? "Repeat playlist" : "Repeat off"} :class {spotify_state.repeat_mode == "track" ? "is-active is-track" : spotify_state.repeat_active ? "is-active" : ""}))
    (ui_link_row :label "PLAYLISTS" :icon "󰅂" :command "~/.config/eww/scripts/spotify-playlists-popup.sh")))

(defwidget spotify_playlists_popup_content []
  (box :class "ui-surface ui-popup playlists-popup" :orientation "v" :space-evenly false
    (ui_header :eyebrow "SPOTIFY" :title "Playlists" :subtitle "Choose what plays next" :meta "")
    (scroll :class "ui-scroll" :vscroll true :height 220 :vexpand false :valign "start"
      (box :class "ui-list" :orientation "v" :space-evenly false :vexpand false
        (for playlist in {spotify_playlists_state}
          (playlist_row :playlist playlist))))))

(defwindow spotify_player
  :monitor 0
  :geometry (geometry :anchor "top center" :y "40px")
  :stacking "fg"
  :focusable "ondemand"
  :namespace "eww-spotify"
  :windowtype "normal"
  (spotify_popup_content))

(defwindow spotify_playlists
  :monitor 0
  :geometry (geometry :width "320px" :height "320px" :anchor "top center" :y "40px")
  :stacking "fg"
  :focusable "ondemand"
  :namespace "eww-spotify-playlists"
  :windowtype "normal"
  (spotify_playlists_popup_content))
