;; Quick-settings panel. Per-domain preview popups are the primary UI; the
;; status cards here launch them instead of duplicating their content.

(defpoll shell_state :interval "15s" :initial "{\"health\":{\"load\":\"0\",\"memory\":0,\"disk\":0,\"temperature\":0,\"failed_services\":0,\"processes\":[]},\"network_details\":{\"ips\":[],\"gateway\":\"Unavailable\",\"dns\":[],\"rx_rate\":0,\"tx_rate\":0,\"vpn\":[],\"tailscale\":false,\"tailscale_name\":\"\"},\"display\":{\"monitors\":[],\"night_light\":false,\"wallpaper\":\"\"},\"media\":{\"players\":[],\"available\":false,\"has_players\":false,\"first_token\":\"\",\"first_playing\":false,\"first_position\":0,\"first_length\":0},\"focus\":{\"active\":false,\"minutes\":0,\"remaining\":0,\"remaining_text\":\"00:00\"},\"clipboard\":{\"available\":false,\"items\":[]},\"downloads\":[],\"screenshots\":[],\"windows\":[],\"mounts\":[],\"privacy\":{\"microphone_in_use\":false,\"camera_in_use\":false,\"camera_available\":false},\"development\":{\"kubectl\":false,\"context\":\"Not configured\",\"ports\":[],\"docker\":false,\"podman\":false},\"nixos\":{\"generation\":\"Unavailable\",\"dirty\":false,\"revision\":\"\",\"generations\":0,\"closure_size\":\"Unavailable\"},\"weather\":{\"available\":false,\"summary\":\"Not configured\",\"location\":\"Not configured\"},\"smart_home\":{\"available\":false,\"summary\":\"Not configured\"}}" `/home/lucid/.config/eww/scripts/shell-state.py`)

(defwidget shell_toggle_grid []
  (box :class "shell-toggle-grid" :orientation "h" :space-evenly true
    (ui_icon_action :icon {network_state.enabled ? "󰖩" : "󰖪"} :command "~/.config/eww/scripts/system-action.sh network power" :tooltip "Toggle Wi-Fi" :class {network_state.enabled ? "is-primary" : ""})
    (ui_icon_action :icon {bluetooth_state.powered ? "󰂯" : "󰂲"} :command "~/.config/eww/scripts/system-action.sh bluetooth power" :tooltip "Toggle Bluetooth" :class {bluetooth_state.powered ? "is-primary" : ""})
    (ui_icon_action :icon {audio_state.muted ? "󰝟" : "󰕾"} :command "~/.config/eww/scripts/system-action.sh audio mute" :tooltip "Toggle mute" :class {audio_state.muted ? "" : "is-primary"})
    (ui_icon_action :icon {notification_state.dnd ? "󰂛" : "󰂚"} :command "~/.config/eww/scripts/system-action.sh notifications dnd" :tooltip "Do not disturb" :class {notification_state.dnd ? "is-primary" : ""})
    (ui_icon_action :icon {power_state.idle_active ? "󰒲" : "󰅶"} :command "~/.config/eww/scripts/system-action.sh power idle" :tooltip "Caffeine" :class {power_state.idle_active ? "" : "is-primary"})
    (ui_icon_action :icon "󰖔" :command "~/.config/eww/scripts/shell-action.sh display night-light" :tooltip "Night light" :class {shell_state.display.night_light ? "is-primary" : ""})))

(defwidget shell_popup_link [icon title subtitle value command active]
  (eventbox :class "ui-row" :onclick command
    (box :class "ui-row-content shell-popup-link ${active ? "is-active" : ""}" :orientation "h" :spacing 10 :space-evenly false :hexpand true
      (label :class "system-row-icon" :text icon :valign "center")
      (box :orientation "v" :space-evenly false :hexpand true :valign "center"
        (label :class "system-row-title" :text title :xalign 0.0 :limit-width 34 :show-truncated true)
        (label :class "ui-muted system-row-subtitle" :text subtitle :xalign 0.0 :limit-width 34 :show-truncated true :visible {subtitle != ""}))
      (label :class "ui-meta" :text value :halign "end" :valign "center" :visible {value != ""}))))

(defwidget shell_media_row [player]
  (system_data_row :icon {player.status == "Playing" ? "󰐊" : "󰏤"} :title {player.title} :subtitle {player.artist != "" ? player.artist : player.name} :trailing {player.status} :command {player.status == "Playing" ? "~/.config/eww/scripts/shell-action.sh media play-pause ${player.token}" : "true"} :class {player.status == "Playing" ? "is-active" : ""}))

(defwidget shell_controls []
  (box :orientation "v" :space-evenly false
    (ui_header :eyebrow "QUICK SETTINGS" :title "Desktop control center" :subtitle "${shell_state.health.memory}% memory · ${shell_state.health.disk}% disk · load ${shell_state.health.load}" :meta "${power_state.capacity}%")
    (shell_toggle_grid)
    (system_slider :icon "󰕾" :label {audio_state.device} :value {audio_state.volume} :command "~/.config/eww/scripts/system-action.sh audio volume {}")
    (system_slider :icon "󰃠" :label "Display brightness" :value {power_state.brightness} :command "~/.config/eww/scripts/system-action.sh power brightness {}")
    (ui_section_header :title "OPEN PANELS" :meta "")
    (shell_popup_link :icon "󰂚" :title "Notifications" :subtitle {notification_state.dnd ? "Do not disturb on" : "Live alerts"} :value "${notification_state.count}" :command "~/.config/eww/scripts/widget-preview.sh notifications" :active false)
    (shell_popup_link :icon "󰂯" :title "Connected devices" :subtitle {audio_state.nothing_connected ? "Nothing Headphones controls" : "Audio, Bluetooth and privacy"} :value "${bluetooth_state.connected_count}" :command "~/.config/eww/scripts/widget-preview.sh audio" :active {shell_state.privacy.microphone_in_use || shell_state.privacy.camera_in_use})
    (shell_popup_link :icon "󰖩" :title "Network" :subtitle {network_state.active != "" ? network_state.active : "Not connected"} :value {network_state.enabled ? "ON" : "OFF"} :command "~/.config/eww/scripts/widget-preview.sh wifi" :active false)
    (shell_popup_link :icon "󰒓" :title "Power and session" :subtitle "${power_state.capacity}% · ${power_state.profile}" :value {power_state.idle_active ? "IDLE ON" : "CAFFEINE"} :command "~/.config/eww/scripts/widget-preview.sh power" :active {!power_state.idle_active})
    (shell_popup_link :icon "󰆍" :title "Desktop tools" :subtitle "Clipboard, windows, screenshots and development" :value "OPEN" :command "~/.config/eww/scripts/tools-popup.sh" :active false)
    (ui_section_header :title "NOW PLAYING" :meta {shell_state.focus.active ? "FOCUS ${shell_state.focus.remaining_text}" : "${arraylength(shell_state.media.players)} PLAYERS"})
    (box :class "ui-list" :orientation "v" :space-evenly false
      (for player in {shell_state.media.players} (shell_media_row :player player))
      (label :class "ui-empty" :text "No media players running" :visible {arraylength(shell_state.media.players) == 0}))
    (box :class "shell-progress" :visible {shell_state.media.first_length > 0}
      (box :class "shell-progress-fill" :halign "begin" :hexpand false :width "${(shell_state.media.first_position * 100) / shell_state.media.first_length}%"))
    (box :visible {shell_state.media.has_players} :class "ui-action-bar" :halign "center" :spacing 4
      (ui_icon_action :icon "󰒮" :command "~/.config/eww/scripts/shell-action.sh media previous ${shell_state.media.first_token}" :tooltip "Previous track" :class "")
      (ui_icon_action :icon {shell_state.media.first_playing ? "󰏤" : "󰐊"} :command "~/.config/eww/scripts/shell-action.sh media play-pause ${shell_state.media.first_token}" :tooltip "Play or pause" :class "is-primary")
      (ui_icon_action :icon "󰒭" :command "~/.config/eww/scripts/shell-action.sh media next ${shell_state.media.first_token}" :tooltip "Next track" :class ""))
    (box :class "ui-action-bar" :halign "center" :spacing 4
      (ui_icon_action :icon "󰃭" :command "~/.config/eww/scripts/shell-action.sh calendar create" :tooltip "Create calendar event" :class "")
      (ui_icon_action :icon "󰔟" :command "~/.config/eww/scripts/shell-action.sh focus start 25" :tooltip "Start 25-minute focus" :class {shell_state.focus.active ? "is-primary" : ""})
      (ui_icon_action :icon "󰅖" :command "~/.config/eww/scripts/shell-action.sh focus stop" :tooltip "Stop focus" :class {shell_state.focus.active ? "" : ""})
      (ui_icon_action :icon "󰍉" :command "~/.config/eww/scripts/shell-action.sh clipboard search" :tooltip "Search clipboard" :class "")
      (ui_icon_action :icon "󰒍" :command "~/.config/eww/scripts/shell-action.sh network diagnostics" :tooltip "Network diagnostics" :class ""))
    (ui_section_header :title "SYSTEM HEALTH" :meta {shell_state.health.failed_services > 0 ? "${shell_state.health.failed_services} FAILED" : "HEALTHY"})
    (shell_popup_link :icon "󱄅" :title {shell_state.nixos.generation} :subtitle "${shell_state.nixos.generations} generations · ${shell_state.nixos.closure_size}" :value {shell_state.nixos.dirty ? "DIRTY" : shell_state.nixos.revision} :command "true" :active {shell_state.nixos.dirty})))

(defwidget control_center []
  (box :class "ui-surface ui-popup shell-popup" :orientation "v" :space-evenly false
    (scroll :class "ui-scroll shell-scroll" :vscroll true :height 570 :vexpand false
      (shell_controls))))

(defwindow control_center_popup
  :monitor 0
  :geometry (geometry :width "700px" :height "650px" :anchor "top left")
  :stacking "fg"
  :namespace "eww-control-center"
  :windowtype "normal"
  (control_center))
